# ==========================================
# DevOps Repository Root .gitignore
# ==========================================

# --- Terraform ---
# Ignore provider binaries, cache, and state files
**/.terraform/
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl
*.tfvars
*.tfvars.json

# --- SSH Keys & Secrets ---
*.pem
*.key
terra-key
terra-key.pub
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.pkcs12
*.pfx
.env
.env.*
!.env.example

# --- Node.js / Web ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
dist/
build/

# --- Java / Maven / Gradle ---
target/
.gradle/
*.class
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
*.egg-info/
.mypy_cache/

# --- OS & IDEs ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Large Binaries & Log files ---
*.iso
*.exe
*.dll
*.so
*.dylib
*.log
