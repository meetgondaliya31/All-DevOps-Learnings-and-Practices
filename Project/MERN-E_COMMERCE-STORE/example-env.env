# ============================================
# MERN E-Commerce Store - Environment Variables
# ============================================

# ============ SERVER CONFIGURATION ============
# Port on which the backend server runs
PORT=5000

# ============ DATABASE CONFIGURATION ============
# MongoDB connection string
# For local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/huxnStore

# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/huxnStore?retryWrites=true&w=majority

# ============ JWT AUTHENTICATION ============
# Secret key for JWT token generation and verification
# Use a strong random string in production
JWT_SECRET=abac12afsdkjladf

# ============ PAYPAL INTEGRATION ============
# PayPal Client ID for payment processing
# Get from https://developer.paypal.com/
# Use Sandbox credentials for testing, Live credentials for production
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# ============ OPTIONAL CONFIGURATIONS ============
# Node environment
NODE_ENV=development

# CORS configuration (if needed)
# CORS_ORIGIN=http://localhost:5173